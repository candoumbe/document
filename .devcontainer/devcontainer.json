{
  "name": "Documents",
  "image": "mcr.microsoft.com/devcontainers/dotnet:10.0",
  "features": {
    "ghcr.io/devcontainers-extra/features/gh-cli:1": {},
    "ghcr.io/devcontainers/features/git:1.3.8": {},
    "ghcr.io/devcontainers/features/github-cli:1.1.2": {},
    "ghcr.io/devcontainers/features/copilot-cli:1.1.3": {},
    "ghcr.io/devcontainers/features/docker-in-docker:4.1.0": {
      "moby": true,
      "dockerDashComposeVersion": "v2"
    },
    "ghcr.io/nils-geistmann/devcontainers-features/zsh": {
      "plugins": "git npm gh docker ng"
    },
    "ghcr.io/devcontainers/features/dotnet": {
      "version": "10.0.400"
    },
    "ghcr.io/devcontainers-extra/features/angular-cli": {}
  },
  "containerEnv": {
    "TESTCONTAINERS_RYUK_CONTAINER_PRIVILEGED": "false",
    "IS_DEVCONTAINER": "true"
  },
  "onCreateCommand": "bash ./.devcontainer/scripts/on-create.sh",
  "postCreateCommand": "bash ./.devcontainer/scripts/post-create.sh",
  "postStartCommand": "bash ./.devcontainer/scripts/post-start.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-dotnettools.csharp",
        "ms-dotnettools.csdevkit",
        "esbenp.prettier-vscode",
        "ms-azuretools.vscode-docker",
        "microsoft-aspire.aspire-vscode",
        "GitHub.copilot",
        "EditorConfig.EditorConfig",
        "mhutchie.git-graph",
        "zaaack.markdown-editor",
        "adrianwilczynski.user-secrets",
        "github.vscode-github-actions"
      ],
      "settings": {
        "dotnet.defaultSolution": "Document.slnx",
        "chat.tools.compressOutput.enabled": true,
        "chat.tools.riskAssessment.enabled": true,
        "chat.permissions.default": "autoApprove",
        "aspire.dashboardBrowser": "integratedBrowser",
        "aspire.closeDashboardOnDebugEnd": true
      }
    }
  },
  "runArgs": [
    "--privileged",
    "--env-file",
    "${localWorkspaceFolder}/.devcontainer/.env"
  ]
}
