<Project Sdk="Aspire.AppHost.Sdk/13.5.0">

  <Import Project="../../core.props" />
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UserSecretsId>00356808-6657-4a2d-99c7-be9ce6d67892</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.AppHost"/>
    <PackageReference Include="Aspire.Hosting.PostgreSQL"/>
  </ItemGroup>

  <!-- Same logical name as in build/Documents.Pipelines.csproj: ContainerImages resolves it by that name in both assemblies. -->
  <ItemGroup>
    <EmbeddedResource Include="container-images.json" LogicalName="Documents.Aspire.container-images.json" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Documents.API\Documents.API.csproj" />
    <ProjectReference Include="..\Documents.Migrator\Documents.Migrator.csproj" />
  </ItemGroup>
</Project>